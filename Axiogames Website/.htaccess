DirectoryIndex index.html
AddType application/manifest+json .webmanifest
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^(index\.html|hub-sw\.js|manifest\.webmanifest|icons\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

RewriteEngine On

RewriteCond %{HTTP_HOST} ^www\.axiomategames\.com$ [NC]
RewriteRule ^(.*)$ https://axiomategames.com/$1 [R=301,L]

RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://axiomategames.com/$1 [R=301,L]

RewriteRule ^$ /home [R=302,L]

RewriteRule ^about/?$ /home#about [R=301,NE,L]
RewriteRule ^others/marketplace/?$ /hub?section=market [R=301,L]

RewriteRule ^app(/|$) - [F,L]
RewriteRule (^|/)\.(?!well-known) - [F,L]

RewriteRule ^api(/.*)?$ /api/index.php [L,QSA]
RewriteRule ^staff(/.*)?$ /staff/index.php [L,QSA]
RewriteRule ^hub-admin(/.*)?$ /hub-admin/index.php [L,QSA]

RewriteCond %{THE_REQUEST} \s/+(.+?)/?index\.html[\s?]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]

RewriteRule ^(.+)/$ /$1 [R=301,L]

RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^([^/.]+(?:/[^/.]+)?)$ /$1/index.html [L]
